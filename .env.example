# Salin file ini menjadi .env.local dan isi dengan nilai Anda.
# Jangan pernah commit file .env.local yang berisi API key asli.

# API key dari Google Cloud Console, dibatasi pada API Google Sheets.
VITE_GOOGLE_SHEETS_API_KEY=

# ID spreadsheet, diambil dari URL /d/<ID_SPREADSHEET>/edit
VITE_GOOGLE_SHEET_ID=

# Opsional: batasi dashboard pada satu tab sheet saja (gid internal sheet).
# Kosongkan untuk membaca seluruh tab spreadsheet.
VITE_GOOGLE_SHEET_GID=
